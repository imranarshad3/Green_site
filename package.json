{
  "name": "plantify",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run db:start && npm run dev -w client",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client",

    "db:start": "npm run start -w server",
    "db:stop": "npm run stop -w server",
    "db:reset": "npm run reset -w server",
    "db:seed": "npm run seed -w server"
  }
}
